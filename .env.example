# ============================================================================
# CONFIGURACAO DO BANCO DE DADOS NEON POSTGRESQL
# ============================================================================
# Obtenha sua string de conexao no painel do Neon (https://console.neon.tech)
# Exemplo:
# DATABASE_URL=postgresql://neondb_owner:npg_xxxx@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Limite de tamanho no Neon (plano gratuito = 1 GB). Ao passar deste valor, a
# coleta continua gravando só no SQLite local.
NEON_LIMITE_MB=900
# Tamanho máximo das descrições longas gravadas no banco
DESCRICAO_MAX_CHARS=400
