# ============================================================================
# CONFIGURACAO DO DASHBOARD WEB (MODULO compras-ti-cobit5/dashboard)
# ============================================================================
# Quando colocado em compras-ti-cobit5/dashboard/, o servidor herda
# automaticamente a variavel DATABASE_URL do arquivo ../.env na raiz do
# repositorio. Opcionalmente, voce pode sobrescreve-la aqui criando um .env
# local nesta pasta.
#
# Exemplo:
# DATABASE_URL=postgresql://neondb_owner:npg_xxxx@ep-exemplo.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Porta do servidor HTTP (padrao: 3000)
PORT=3000
